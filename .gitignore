# ---- 環境設定（実環境のIP・ホスト名を含むためコミットしない） ----
.env

# ---- MiniStack のデータ永続化ディレクトリ ----
compose/data/
# reset 時に退避されるデータ（compose/data.bak-<日時>/）
compose/data.bak-*/
# MINISTACK_BLOCKED_HOSTS から自動生成される上書き（実環境のホスト名を含み得る）
compose/docker-compose.blocked-hosts.yml

# ---- Terraform ----
.terraform/
.terraform.lock.hcl.bak
*.tfstate
*.tfstate.*
crash.log
crash.*.log
*.tfplan
# scripts/tf.sh が環境に応じて生成するバックエンド定義
terraform/**/backend.generated.tf

# ---- 一時ファイル ----
*.tmp
.DS_Store
