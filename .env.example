# =============================================================================
# proxmox-ministack 環境設定
#   使い方:  cp .env.example .env  して自宅環境に合わせて編集する
#   読み込み: lib/ministack.sh が自動で読み込む（シェルに既に設定済みの値が優先）
# =============================================================================

# ---- MiniStack コンテナ ----------------------------------------------------
# Dockerイメージのタグ（latest / 1.5 / full / 1.5-full）
# full は Athena・ネイティブDBドライバ同梱版（~360MB）
MINISTACK_VERSION=latest

# MiniStack を稼働させるホスト（Proxmox上のVM/LXCのIP）
# 開発マシン上で直接 docker compose up する場合は localhost のまま
# 例: 192.168.11.50
MINISTACK_HOST=localhost

# ゲートウェイのポート（AWS API の single port）
MINISTACK_PORT=4566

# compose を起動するホスト（Proxmox VM/LXC 自身）を外部から見たアドレス。
# RDS/ElastiCache コンテナのエンドポイントや CloudFront/API Gateway の
# 仮想ホスト名解決に使われる。Proxmox 運用では VM/LXC の IP にする。
MINISTACK_PUBLIC_HOST=localhost

# ---- MiniStack 内部のリージョン・アカウント --------------------------------
# このリージョンで Terraform リソースが作られる（state もリージョン単位で分離）。
# scripts/tf.sh がプロバイダ（aws_region）と tfstateバックエンド（region）の
# 両方へ自動注入する
MINISTACK_REGION=ap-northeast-1

# 12桁の数値にするとテナント分離（マルチアカウント）になる。通常はデフォルトのまま
MINISTACK_ACCOUNT_ID=000000000000

# ---- 本番 AWS 側の設定 -------------------------------------------------------
# scripts/tf.sh aws / migrate-*.sh で参照する本番リージョン
AWS_REGION=ap-northeast-1

# コンソールログの冗長さ（DEBUG / INFO / WARN / ERROR）
LOG_LEVEL=INFO

# ---- 実環境への誤送信の防止 -------------------------------------------------
# MiniStack は SNS の HTTPS 購読確認・EventBridge の API destination・API Gateway の
# HTTP 統合を、設定された URL へ「実際に」送信する。実在する環境（本番・ステージング等）の
# Terraform 構成を流し込むなら、その環境のホスト名をここに列挙する（カンマ区切り）。
# MiniStack コンテナ内で 127.0.0.1 に解決され、接続が拒否される。.env はコミットしないこと。
# 例: MINISTACK_BLOCKED_HOSTS="api.example.com,api-stg.example.com"
MINISTACK_BLOCKED_HOSTS=
